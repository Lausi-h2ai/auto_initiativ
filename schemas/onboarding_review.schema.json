{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-initiativ.local/schemas/onboarding_review.schema.json",
  "title": "OnboardingReview",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "run_id", "created_at", "items"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "review_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/review_item" }
    }
  },
  "$defs": {
    "review_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_item_id",
        "item_type",
        "target_file",
        "target_json_pointer",
        "summary",
        "proposed_value",
        "provenance",
        "confidence",
        "state",
        "reviewer_metadata",
        "resolution_notes"
      ],
      "properties": {
        "review_item_id": { "type": "string", "minLength": 1 },
        "item_type": {
          "type": "string",
          "enum": [
            "missing_required_information",
            "contradiction",
            "low_confidence",
            "inferred_claim",
            "policy_decision",
            "user_confirmation_required",
            "correction",
            "other"
          ]
        },
        "target_file": {
          "type": "string",
          "enum": ["user_profile.json", "master_cv_profile.json", "policy.json"]
        },
        "target_json_pointer": {
          "type": "string",
          "pattern": "^(/([^/~]|~0|~1)*)*$"
        },
        "related_json_pointers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(/([^/~]|~0|~1)*)*$"
          }
        },
        "summary": { "type": "string", "minLength": 1 },
        "proposed_value": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "integer" },
            { "type": "boolean" },
            { "type": "array" },
            { "type": "object" }
          ]
        },
        "provenance": { "$ref": "#/$defs/provenance" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "state": {
          "type": "string",
          "enum": ["open", "accepted", "rejected", "resolved", "superseded"]
        },
        "reviewer_metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reviewer_id": { "type": "string", "minLength": 1 },
            "reviewed_at": { "type": "string", "format": "date-time" }
          }
        },
        "resolution_notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "confidence", "needs_review", "source_refs"],
      "properties": {
        "source_type": { "type": "string", "enum": ["verified_document", "user_claim", "inferred", "needs_review"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "needs_review": { "type": "boolean" },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
