{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-initiativ.local/schemas/email_draft.schema.json",
  "title": "EmailDraft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_id", "company_id", "contact_id", "subject", "body_text", "claim_refs", "source_refs", "confidence", "review_flags"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "draft_id": { "type": "string", "minLength": 1 },
    "company_id": { "type": "string", "minLength": 1 },
    "contact_id": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "body_text": { "type": "string", "minLength": 1 },
    "body_html": { "type": "string" },
    "tone": { "type": "string" },
    "claim_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "attachments": {
      "type": "array",
      "items": { "$ref": "#/$defs/attachment_ref" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "review_flags": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "attachment_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment_id", "path", "kind"],
      "properties": {
        "attachment_id": { "type": "string" },
        "path": { "type": "string" },
        "kind": { "type": "string", "enum": ["cv", "cover_letter", "portfolio", "other"] }
      }
    }
  }
}

