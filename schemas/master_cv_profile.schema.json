{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-initiativ.local/schemas/master_cv_profile.schema.json",
  "title": "MasterCvProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "created_at", "claims"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "profile_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    },
    "preferred_cv_sections": {
      "type": "array",
      "items": { "type": "string" }
    },
    "template_refs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "category", "statement", "provenance", "approved_for_tailoring"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "category": {
          "type": "string",
          "enum": ["experience", "project", "education", "skill", "language", "certification", "achievement", "preference", "other"]
        },
        "statement": { "type": "string", "minLength": 1 },
        "start_date": { "type": "string" },
        "end_date": { "type": "string" },
        "organization": { "type": "string" },
        "role": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "approved_for_tailoring": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "confidence", "needs_review", "source_refs"],
      "properties": {
        "source_type": { "type": "string", "enum": ["verified_document", "user_claim", "inferred", "needs_review"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "needs_review": { "type": "boolean" },
        "source_refs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

