# Local demonstration only. Bind the server to 127.0.0.1.
AUTH_REQUIRED=false
DEV_AUTH_BYPASS_EMAIL=demo@local.invalid
PUBLIC_BASE_URL=http://127.0.0.1:8000

# No background research or email delivery in the initial demo.
WORKFLOW_WORKER_ENABLED=false
DRY_RUN=true
EMAIL_SENDING_ENABLED=false
EMAIL_ALLOW_REAL_RECIPIENTS=false

# Defaults use backend/dev.db and runs/. Both are private local data.
# Configure Pi locally before enabling the workflow worker.
# Never commit OAuth credentials, tokens, or real candidate information.
