{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-initiativ.local/schemas/policy.schema.json",
  "title": "Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "created_at", "exclusions", "outreach", "limits", "review_thresholds"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "policy_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["industries", "company_names", "domains", "keywords"],
      "properties": {
        "industries": { "type": "array", "items": { "$ref": "#/$defs/policy_item" } },
        "company_names": { "type": "array", "items": { "$ref": "#/$defs/policy_item" } },
        "domains": { "type": "array", "items": { "$ref": "#/$defs/policy_item" } },
        "keywords": { "type": "array", "items": { "$ref": "#/$defs/policy_item" } }
      }
    },
    "outreach": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_company_repeat", "allow_recipient_repeat", "company_dedupe_window_days", "recipient_dedupe_window_days"],
      "properties": {
        "allow_company_repeat": { "type": "boolean" },
        "allow_recipient_repeat": { "type": "boolean" },
        "company_dedupe_window_days": { "type": "integer", "minimum": 0 },
        "recipient_dedupe_window_days": { "type": "integer", "minimum": 0 },
        "require_manual_review_before_send": { "type": "boolean", "default": true }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daily_send_limit", "weekly_send_limit"],
      "properties": {
        "daily_send_limit": { "type": "integer", "minimum": 0 },
        "weekly_send_limit": { "type": "integer", "minimum": 0 }
      }
    },
    "review_thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_required_confidence", "block_needs_review_required_fields"],
      "properties": {
        "minimum_required_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "block_needs_review_required_fields": { "type": "boolean" }
      }
    },
    "forbidden_claims": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "policy_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason", "provenance"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "reason": { "type": "string" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_type", "confidence", "needs_review", "source_refs"],
          "properties": {
            "source_type": { "type": "string", "enum": ["verified_document", "user_claim", "inferred", "needs_review"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "needs_review": { "type": "boolean" },
            "source_refs": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}

