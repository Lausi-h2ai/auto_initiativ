{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-initiativ.local/schemas/company_candidate.schema.json",
  "title": "CompanyCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "company_id", "name", "domain", "source_refs", "confidence", "review_flags"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "company_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "website_url": { "type": "string", "format": "uri" },
    "domain": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "industry_tags": { "type": "array", "items": { "type": "string" } },
    "locations": { "type": "array", "items": { "type": "string" } },
    "remote_policy": { "type": "string" },
    "potential_policy_conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/policy_conflict" }
    },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "review_flags": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "policy_conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_value", "reason", "confidence"],
      "properties": {
        "policy_value": { "type": "string" },
        "reason": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}

