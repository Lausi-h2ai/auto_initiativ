{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-initiativ.local/schemas/send_intent.schema.json",
  "title": "SendIntent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "intent_id",
    "run_id",
    "company_id",
    "contact_id",
    "email_draft_id",
    "recipient_email",
    "subject",
    "body_text",
    "attachments",
    "source_refs",
    "policy_id",
    "profile_id",
    "master_cv_profile_id",
    "confidence",
    "review_flags",
    "created_by"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "intent_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "company_id": { "type": "string", "minLength": 1 },
    "contact_id": { "type": "string", "minLength": 1 },
    "email_draft_id": { "type": "string", "minLength": 1 },
    "recipient_email": { "type": "string", "format": "email" },
    "recipient_name": { "type": "string" },
    "company_domain": { "type": "string" },
    "subject": { "type": "string", "minLength": 1 },
    "body_text": { "type": "string", "minLength": 1 },
    "body_html": { "type": "string" },
    "attachments": {
      "type": "array",
      "items": { "$ref": "#/$defs/attachment_ref" }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "claim_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "policy_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "master_cv_profile_id": { "type": "string", "minLength": 1 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "review_flags": { "type": "array", "items": { "type": "string" } },
    "created_by": { "type": "string", "enum": ["codex_agent"] }
  },
  "$defs": {
    "attachment_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attachment_id", "path", "kind", "exists_at_draft_time"],
      "properties": {
        "attachment_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["cv", "cover_letter", "portfolio", "other"] },
        "exists_at_draft_time": { "type": "boolean" }
      }
    }
  }
}

